# ==============================================================================
# Streamlit Secrets Configuration
# Legal Document Simplification System
# ==============================================================================


GROQ_API_KEY = ""

# ------------------------------------------------------------------------------
# OPTIONAL - Model Selection
# ------------------------------------------------------------------------------

GROQ_DEFAULT_MODEL = "llama-3.1-8b-instant"

# ------------------------------------------------------------------------------
# OPTIONAL - Rate Limits (Free Tier defaults as of Oct 2025)
# Only override if Groq changes their limits
# ------------------------------------------------------------------------------

# llama-3.1-8b-instant limits (default/fast model)
GROQ_TPM_8B = 250000      # Tokens per minute
GROQ_RPM_8B = 1000        # Requests per minute  
GROQ_RPD_8B = 14400       # Requests per day

# llama-3.3-70b-versatile limits (quality model)
GROQ_TPM_70B = 300000     # Tokens per minute
GROQ_RPM_70B = 1000       # Requests per minute
GROQ_RPD_70B = 14400      # Requests per day



# Warning threshold for rate limit alerts (percentage)
# Show warning when usage exceeds this % of limit
# Default: 80 (shows warning at 80% usage)
RATE_LIMIT_WARNING_THRESHOLD = 80

# Maximum tokens to request in a single API call
# Lower values = more free tier friendly
# Default: 4096, Recommended for free tier: 2048
MAX_TOKENS_PER_REQUEST = 4096

# Request timeout in seconds
# Default: 30 seconds
API_TIMEOUT_SECONDS = 30

DEBUG_MODE = false

# ------------------------------------------------------------------------------
# OPTIONAL - API Endpoint (rarely needs changing)
# ------------------------------------------------------------------------------

GROQ_API_ENDPOINT = "https://api.groq.com/openai/v1/chat/completions"
